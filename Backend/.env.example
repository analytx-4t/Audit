SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@analytx4t.com
SMTP_PASS=your-hostinger-mailbox-password
MAIL_FROM="IKIO <info@analytx4t.com>"
KPI_EMAIL_RECIPIENTS=anoop@analytx4t.com,amit@analytx4t.com

# Dates in email subject / PDF (the droplet clock is UTC)
REPORT_TIMEZONE=Asia/Kolkata
# Undelivered report emails are queued in reports/outbox and retried this often
MAIL_RETRY_INTERVAL_MIN=10

# OCR
MISTRAL_API_KEY=
MISTRAL_OCR_3_MODEL=mistral-ocr-2512
# auto = real-time OCR for uploads below MISTRAL_BATCH_MIN_FILES, batch above
MISTRAL_OCR_MODE=auto
MISTRAL_BATCH_MIN_FILES=100
# Images processed in parallel (each makes up to ~7 Mistral calls)
OCR_CONCURRENCY=4
# Largest single photo accepted (MB)
MAX_UPLOAD_MB=30
